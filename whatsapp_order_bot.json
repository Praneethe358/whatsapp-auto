      "id": "node-update-session-menu",
      "name": "Update Session: MENU_SENT",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [2200, 300]
    },
    {
      "parameters": {
        "jsCode": "// -------------------------------------------------------\n// ORDER PARSER — fixes dosa/masala dosa overlap issue\n// Strategy: sort menu items by LENGTH (longest first)\n// so 'masala dosa' is matched before 'dosa'\n// -------------------------------------------------------\n\nconst MENU = [\n  { name: 'masala dosa',  price: 60,  display: 'Masala Dosa'  },\n  { name: 'plain dosa',   price: 40,  display: 'Plain Dosa'   },\n  { name: 'dosa',         price: 40,  display: 'Plain Dosa'   },\n  { name: 'idli',         price: 30,  display: 'Idli (2 pcs)' },\n  { name: 'pongal',       price: 50,  display: 'Pongal'       },\n  { name: 'vada',         price: 35,  display: 'Vada (2 pcs)' },\n  { name: 'upma',         price: 40,  display: 'Upma'         },\n];\n\n// Sort by name length descending — longest match wins\nMENU.sort((a, b) => b.name.length - a.name.length);\n\nconst input = $json.msgText.toLowerCase();\nlet remaining = input;\nconst orderItems = [];\nconst usedItems = new Set();\n\nfor (const item of MENU) {\n  // Regex: optional number before item name, word boundaries\n  const regex = new RegExp(\n    `(?:(\\\\d+)\\\\s*x?\\\\s*|x?(\\\\d+)\\\\s*)?\\\\b${item.name.replace(/\\\\s+/g, '\\\\\\\\s+')}\\\\b`,\n    'gi'\n  );\n\n  let match;\n  while ((match = regex.exec(remaining)) !== null) {\n    const qty = parseInt(match[1] || match[2] || '1', 10);\n    const key = item.name;\n    if (!usedItems.has(key)) {\n      usedItems.add(key);\n      orderItems.push({\n        name: item.display,\n        qty,\n        unitPrice: item.price,\n        subtotal: qty * item.price\n      });\n      // Replace matched text so it won't be re-matched by shorter alias\n      remaining = remaining.replace(match[0], ' '.repeat(match[0].length));\n    }\n  }\n}\n\nif (orderItems.length === 0) {\n  return [{\n    json: {\n      ...($json),\n      parseError: true,\n      errorMsg: \"Sorry, I couldn't understand your order. Please reply with items from the menu, e.g. *2 idli, 1 masala dosa*\"\n    }\n  }];\n}\n\nconst total = orderItems.reduce((s, i) => s + i.subtotal, 0);\nconst orderSummary = orderItems\n  .map(i => `${i.qty}x ${i.name} — ₹${i.subtotal}`)\n  .join('\\n');\n\nreturn [{\n  json: {\n    ...($json),\n    parseError: false,\n    orderItems,\n    total,\n    orderSummary,\n    cartJson: JSON.stringify(orderItems)\n  }\n}];"
      },
      "id": "node-parse-order",
      "name": "Parse Order",
      "type": "n8n-nodes-base.code",
