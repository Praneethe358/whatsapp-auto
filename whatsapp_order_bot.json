      "id": "node-log-order",
      "name": "Log Order to Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [950, 840]
    },
    {
      "parameters": {
        "jsCode": "const PHONE_NUMBER_ID = 'YOUR_PHONE_NUMBER_ID';\nconst ACCESS_TOKEN = 'YOUR_WHATSAPP_ACCESS_TOKEN';\nconst OWNER_PHONE = 'YOUR_OWNER_WHATSAPP_NUMBER'; // e.g. 919876543210\n\n// Message to customer\nconst customerMsg = {\n  messaging_product: 'whatsapp',\n  to: $json.customerPhone,\n  type: 'text',\n  text: {\n    body: `🎉 *Payment received! Thank you!*\\n\\nOrder ID: *${$json.orderId}*\\nAmount: ₹${$json.amount}\\n\\nYour order is being prepared. Estimated time: 30 mins. 🍽️`\n  }\n};\n\n// Message to owner\nconst ownerMsg = {\n  messaging_product: 'whatsapp',\n  to: OWNER_PHONE,\n  type: 'text',\n  text: {\n    body: `🔔 *New Order Received!*\\n\\nOrder ID: *${$json.orderId}*\\nCustomer: +${$json.customerPhone}\\nAmount: ₹${$json.amount}\\nPayment ID: ${$json.paymentId}\\n\\nPlease prepare the order.`\n  }\n};\n\nreturn [\n  { json: { payload: customerMsg, PHONE_NUMBER_ID, ACCESS_TOKEN, type: 'customer' } },\n  { json: { payload: ownerMsg, PHONE_NUMBER_ID, ACCESS_TOKEN, type: 'owner' } }\n];"
      },
