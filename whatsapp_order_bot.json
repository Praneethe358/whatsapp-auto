    {
      "parameters": {
        "jsCode": "const PHONE_NUMBER_ID = 'YOUR_PHONE_NUMBER_ID';\nconst ACCESS_TOKEN = 'YOUR_WHATSAPP_ACCESS_TOKEN';\n\nconst paymentLink = $json.short_url;\nconst orderId = $('Check YES/NO').first().json.session.orderId;\nconst total = $('Check YES/NO').first().json.session.total;\n\nconst msgText =\n  `✅ Order confirmed! Here's your payment link:\\n\\n` +\n  `💳 Pay ₹${total}: ${paymentLink}\\n\\n` +\n  `Order ID: *${orderId}*\\nPlease complete payment to proceed.`;\n\nconst payload = {\n  messaging_product: 'whatsapp',\n  to: $('Check YES/NO').first().json.phone,\n  type: 'text',\n  text: { body: msgText }\n};\n\nreturn [{\n  json: {\n    payload,\n    PHONE_NUMBER_ID,\n    ACCESS_TOKEN,\n    phone: $('Check YES/NO').first().json.phone,\n    orderId,\n    total,\n    paymentLink\n  }\n}];"
