      "id": "node-get-session",
      "name": "Get Session",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [950, 480],
      "notes": "Looks up customer session state from Sessions sheet. Columns: phone, state, cart, lastUpdated"
    },
    {
      "parameters": {
        "jsCode": "// Merge message data with session data\nconst msg = $('Skip Check').first().json;\nconst sessionData = $input.first().json;\n\n// If no session found, default to IDLE\nconst session = {\n  phone: msg.phone,\n  state: sessionData?.state || 'IDLE',\n  cart: sessionData?.cart || '',\n  lastUpdated: sessionData?.lastUpdated || ''\n};\n\nreturn [{\n  json: {\n    ...msg,\n    session\n  }\n}];"
      },
      "id": "node-merge-session",
      "name": "Merge Session",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 480]
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "value2": "IDLE",
              "operation": "equal",
              "value1": "={{ $json.session.state }}"
            },
            {
              "value2": "MENU_SENT",
              "operation": "equal",
              "value1": "={{ $json.session.state }}"
            },
            {
              "value2": "AWAITING_CONFIRMATION",
              "operation": "equal",
              "value1": "={{ $json.session.state }}"
            },
            {
              "value2": "PAYMENT_PENDING",
              "operation": "equal",
              "value1": "={{ $json.session.state }}"
            }
          ]
        }
      },
      "id": "node-route-state",
      "name": "Route by State",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [1450, 480]
    },
    {
      "parameters": {
        "jsCode": "// Send welcome + menu to customer\nconst PHONE_NUMBER_ID = 'YOUR_PHONE_NUMBER_ID';\nconst ACCESS_TOKEN = 'YOUR_WHATSAPP_ACCESS_TOKEN';\n\nconst menuText = `🍽️ *Welcome to Vynkrova Kitchen!*\\n\\nHere's our menu:\\n\\n` +\n  `1️⃣ Idli (2 pcs) - ₹30\\n` +\n  `2️⃣ Plain Dosa - ₹40\\n` +\n  `3️⃣ Masala Dosa - ₹60\\n` +\n  `4️⃣ Pongal - ₹50\\n` +\n  `5️⃣ Vada (2 pcs) - ₹35\\n` +\n  `6️⃣ Upma - ₹40\\n\\n` +\n  `Reply with your order like:\\n*2 idli, 1 masala dosa, 1 vada*`;\n\nconst payload = {\n  messaging_product: 'whatsapp',\n  to: $json.phone,\n  type: 'text',\n  text: { body: menuText }\n};\n\nreturn [{ json: { payload, phone: $json.phone, PHONE_NUMBER_ID, ACCESS_TOKEN } }];"
      },
      "id": "node-prepare-menu",
      "name": "Prepare Menu",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $json.PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.ACCESS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {}
      },
      "id": "node-send-menu",
      "name": "Send Menu via WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1950, 300]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
