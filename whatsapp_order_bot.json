    {
      "parameters": {
        "jsCode": "// Customer confirmed YES — create Razorpay payment link\nconst RAZORPAY_KEY_ID = 'YOUR_RAZORPAY_KEY_ID';\nconst RAZORPAY_KEY_SECRET = 'YOUR_RAZORPAY_KEY_SECRET';\nconst auth = btoa(`${RAZORPAY_KEY_ID}:${RAZORPAY_KEY_SECRET}`);\n\nconst payload = {\n  amount: $json.session.total * 100, // paise\n  currency: 'INR',\n  accept_partial: false,\n  description: `Order ${$json.session.orderId}`,\n  customer: {\n    contact: `+${$json.phone}`\n  },\n  notify: {\n    sms: false,\n    email: false\n  },\n  reminder_enable: false,\n  notes: {\n    order_id: $json.session.orderId,\n    customer_phone: $json.phone\n  },\n  callback_url: 'https://YOUR_NGROK_URL/webhook/razorpay-callback',\n  callback_method: 'get'\n};\n\nreturn [{\n  json: {\n    ...($json),\n    razorpayPayload: payload,\n    razorpayAuth: auth\n  }\n}];"
