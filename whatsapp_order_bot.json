      "notes": "Razorpay calls this webhook on payment events"
    },
    {
      "parameters": {
        "jsCode": "// Extract Razorpay payment status\nconst body = $input.first().json.body;\nconst event = body.event;\nconst paymentLinkId = body.payload?.payment_link?.entity?.id;\nconst paymentId = body.payload?.payment?.entity?.id;\nconst amount = body.payload?.payment?.entity?.amount / 100;\nconst status = body.payload?.payment?.entity?.status;\nconst notes = body.payload?.payment_link?.entity?.notes || {};\nconst orderId = notes.order_id;\nconst customerPhone = notes.customer_phone;\n\nconst isSuccess = event === 'payment_link.paid';\n\nreturn [{\n  json: {\n    event, paymentLinkId, paymentId, amount,\n    status, orderId, customerPhone, isSuccess\n  }\n}];"
      },
      "id": "node-parse-razorpay",
      "name": "Parse Razorpay Event",
      "type": "n8n-nodes-base.code",
