    {
      "parameters": {
        "jsCode": "// Generate Order ID\nconst orderId = 'ORD' + Date.now().toString().slice(-6);\n\nconst PHONE_NUMBER_ID = 'YOUR_PHONE_NUMBER_ID';\nconst ACCESS_TOKEN = 'YOUR_WHATSAPP_ACCESS_TOKEN';\n\nconst confirmText =\n  `🧾 *Order Summary*\\n\\n` +\n  `${$json.orderSummary}\\n\\n` +\n  `💰 *Total: ₹${$json.total}*\\n\\n` +\n  `Reply *YES* to confirm or *NO* to cancel.`;\n\nconst payload = {\n  messaging_product: 'whatsapp',\n  to: $json.phone,\n  type: 'text',\n  text: { body: confirmText }\n};\n\nreturn [{\n  json: {\n    ...($json),\n    orderId,\n    payload,\n    PHONE_NUMBER_ID,\n    ACCESS_TOKEN\n  }\n}];"
      },
