{
  "name": "WhatsApp Order Bot - Vynkrova",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook",
      "name": "WhatsApp Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 400]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "whatsapp-webhook",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "node-webhook-verify",
      "name": "WhatsApp Verify Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 600],
      "notes": "Meta sends a GET request to verify the webhook. This node handles it."
    },
    {
      "parameters": {
        "jsCode": "// Handle Meta webhook verification challenge\nconst query = $input.first().json.query;\nconst VERIFY_TOKEN = 'vynkrova_verify_2025';\n\nif (\n  query['hub.mode'] === 'subscribe' &&\n  query['hub.verify_token'] === VERIFY_TOKEN\n) {\n  return [{ json: { challenge: query['hub.challenge'] } }];\n}\nreturn [{ json: { error: 'Invalid verification token' } }];"
      },
      "id": "node-verify-challenge",
      "name": "Return Verify Challenge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 600]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.challenge }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node-respond-verify",
      "name": "Respond Verification",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [700, 600]
    },
    {
      "parameters": {
        "jsCode": "// Extract message data from WhatsApp Cloud API payload\nconst body = $input.first().json.body;\n\ntry {\n  const entry = body.entry?.[0];\n  const change = entry?.changes?.[0];\n  const value = change?.value;\n\n  // Ignore status updates (delivery receipts etc)\n  if (value?.statuses) {\n    return [{ json: { skip: true } }];\n  }\n\n  const message = value?.messages?.[0];\n  if (!message) {\n    return [{ json: { skip: true } }];\n  }\n\n  const phone = message.from; // customer phone number\n  const msgType = message.type;\n  const msgText = msgType === 'text' ? message.text.body.trim() : '';\n  const timestamp = message.timestamp;\n  const waId = message.id;\n  const businessPhone = value?.metadata?.phone_number_id;\n\n  return [{\n    json: {\n      phone,\n      msgText,\n      msgType,\n      timestamp,\n      waId,\n      businessPhone,\n      skip: false\n    }\n  }];\n} catch (e) {\n  return [{ json: { skip: true, error: e.message } }];\n}"
      },
      "id": "node-extract-message",
      "name": "Extract Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 400]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.skip }}",
              "value2": true
            }
          ]
        }
      },
      "id": "node-skip-check",
      "name": "Skip Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [700, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\": \"ok\"}",
        "options": { "responseCode": 200 }
      },
      "id": "node-respond-skip",
      "name": "Respond OK (Skip)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [950, 300]
    },
    {
      "parameters": {
