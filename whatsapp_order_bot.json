      "parameters": {
        "jsCode": "// Customer replied YES or NO\nconst reply = $json.msgText.toUpperCase().trim();\nconst isYes = reply === 'YES' || reply === 'Y' || reply.includes('YES');\nreturn [{ json: { ...($json), isYes } }];"
